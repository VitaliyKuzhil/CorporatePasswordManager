# Generate SECRET_KEY and SSO_SECRET_KEY with: openssl rand -hex 32
# Generate ENCRYPTION_KEY with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep encryption keys outside database backups. ENCRYPTION_KEYS is a comma-separated rotation list.

DEBUG=false
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=3307
PHPMYADMIN_PORT=8081
COMPANY_CRM_PORT=8001

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=corporate_password_manager
MYSQL_USER=app_user
MYSQL_PASSWORD=

SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_KEYS=
SSO_SECRET_KEY=
# Leave empty to derive it from COMPANY_CRM_PORT; set explicitly for a custom public callback URL.
SSO_AUDIENCE=
COOKIE_SECURE=false

DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=